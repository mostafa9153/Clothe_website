# Supabase Configuration (Free project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-keep-private

# Razorpay TEST Mode Credentials (never use live key in test/dev)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_1234567890abcdef
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret_here

# Resend Email API Key (optional: if omitted, emails safely log to console)
RESEND_API_KEY=

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
